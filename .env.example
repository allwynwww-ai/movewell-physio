# Copy to .env.local for local development. Never commit real values.

# ── Online booking (Pro) ─────────────────────────────────────────────
# Turn online booking on without editing site.config.ts (e.g. for a preview deploy).
# true/false. When unset, features.onlineBooking in src/site.config.ts decides.
NEXT_PUBLIC_FEATURE_ONLINE_BOOKING=

# Postgres connection string. Vercel → Storage → Neon sets DATABASE_URL / POSTGRES_URL for you.
DATABASE_URL=
# POSTGRES_URL=

# Random secret (32+ characters) used to sign patient manage links and the admin login cookie.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Password for /admin.
ADMIN_PASSWORD=

# Optional: confirmation emails via https://resend.com. Without a key, emails are skipped (logged only).
RESEND_API_KEY=
# Sender address on a domain verified in Resend (onboarding@resend.dev only delivers to your own Resend account email).
RESEND_FROM_EMAIL=
# Where new-booking alerts go (defaults to onlineBooking.clinicNotifyEmail, then contact.email in site.config.ts).
CLINIC_NOTIFY_EMAIL=
